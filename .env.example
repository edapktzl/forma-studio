POSTGRES_DB=forma
POSTGRES_USER=forma
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
ENVIRONMENT=development
# Compose builds DATABASE_URL from the POSTGRES_* values above.
# Use URL-safe password characters (letters, digits, hyphens, underscores).
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
RESEND_API_KEY=
MAIL_FROM=Forma Studio <notifications@example.com>
ADMIN_NOTIFICATION_EMAIL=studio@example.com
